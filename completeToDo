<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    * {
        box-sizing: border-box;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        background-color: #f4f7f6;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        min-height: 100vh;
        margin: 0;
        padding: 40px 20px;
    }


    #inp1 {
        width: 100%;
        max-width: 450px;
        padding: 12px 16px;
        font-size: 16px;
        border: 2px solid #ddd;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.3s ease;
        margin-bottom: 12px;
    }

    #inp1:focus {
        border-color: #4a90e2;
    }

    body > button {
        width: 100%;
        max-width: 450px;
        padding: 12px;
        font-size: 16px;
        font-weight: 600;
        background-color: #4a90e2;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.1s ease;
        margin-bottom: 24px;
    }

    body > button:hover {
        background-color: #357abd;
    }

    body > button:active {
        transform: scale(0.98);
    }

    
    #output {
        width: 100%;
        max-width: 450px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


    .styledResult {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #ffffff;
        padding: 12px 16px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        border-left: 4px solid #4a90e2;
    }

    .styledResult p {
        margin: 0;
        font-size: 16px;
        color: #333333;
        word-break: break-word;
    }

    .styledResult div {
        display: flex;
        gap: 8px;
    }


    .styledResult button {
        padding: 6px 12px;
        font-size: 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        transition: background-color 0.2s ease, opacity 0.2s ease;
    }

    .styledResult button:first-child {
        background-color: #f0ad4e;
        color: white;
    }

    .styledResult button:first-child:hover {
        background-color: #ec971f;
    }

    .styledResult button:last-child {
        background-color: #d9534f;
        color: white;
    }

    .styledResult button:last-child:hover {
        background-color: #c9302c;
    }
</style>
<body>
    <input type="text" id="inp1" >
    <button onclick="enterToDo()">Enter ToDo</button>
    <output id="output"></output>
    
</body>
<script>
  let input = document.getElementById('inp1')
  let output = document.getElementById('output')
  
  let toDoArr = []
  

  
  function displaytoDo(params) {
    output.innerHTML = ''
    toDoArr.forEach((item , index) => {
        let result = `<div class="styledResult">
            <p>${index + 1}. ${item}</p> 
            <div>
             <button onclick="editToDo(${index})">Edit</button>
             <button onclick="deleteToDo(${index})">Delete</button>
            </div>
        </div> `
        output.innerHTML += result
    });


  }
  function enterToDo() {
    let inputValue = input.value.trim()
    
   
    if (inputValue) {
        toDoArr.push(inputValue)
        console.log(toDoArr);
        displaytoDo()
        input.value = ''
         
    } else {
        alert ('Oga input a ToDo na')
        return;
    }
    
  } 
  function deleteToDo(index) {
    toDoArr.splice(index , 1)
    displaytoDo()
  }
  function editToDo(index) {
    let editText = prompt('Update your todo:', toDoArr[index]);
    if (editText !== null && editText.trim() !== '') {
      toDoArr[index] = editText.trim();
      displaytoDo(); 
    }
   }
</script>
</html>
